---
/*
 * STOP — do not modify this file without explicit justification AND go-ahead
 * (see CLAUDE.md, "Architecture"). This is the SPA catch-all route AND the
 * /keystatic admin carve-out; it also 404s unknown paths. A new route that
 * SHADOWS it (like /country/[cca3].astro) counts as affecting it — flag that
 * too before adding one.
 */
import Base from '../layouts/Base.astro';
import AppShell from '../components/AppShell';
// Server-rendered catch-all — handles all Wouter client-side routes including
// dynamic ones like /country/:cca3 and /world-analysis/:cca3
export const prerender = false;

// Exclude keystatic routes - let the Keystatic integration handle them
if (Astro.url.pathname.startsWith('/keystatic')) {
  return Astro.reroute(new Request(Astro.request));
}

// Real 404s. This catch-all only receives paths with no dedicated .astro page: either
// valid client-only Wouter routes (serve 200 + SPA) or genuinely unknown paths (still
// serve the SPA so its NotFound page renders, but with a real 404 status so search
// engines don't treat dead URLs as live "soft-200" pages). Keep this list in sync with
// the client routes in src/components/AppShell.tsx that have no .astro twin.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const knownClientRoutes = new Set([
  '/notes/canada-resources',
  '/world-analysis',
  '/tools/critical-minerals-map',
  '/portfolio/canada-resources',
  '/portfolio/canada-forest-system-climate-industrial-pressure',
  '/historical-risk-demo',
  '/layered-map-demo',
  '/global-risk-cascade',
  '/risk-correlations',
]);
// Dynamic country routes: /country/:cca3 and /world-analysis/:cca3 (ISO-ish codes)
const dynamicClientRoute = /^\/(country|world-analysis)\/[A-Za-z]{2,4}$/;
if (!knownClientRoutes.has(path) && !dynamicClientRoute.test(path)) {
  Astro.response.status = 404;
}
---
<Base>
  <AppShell client:only="react" />
</Base>
