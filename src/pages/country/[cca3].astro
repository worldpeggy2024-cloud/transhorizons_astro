---
/**
 * src/pages/country/[cca3].astro
 *
 * Server-rendered SEO layer for country situation reports. COPIES the existing
 * article SSR pattern (hidden SEO div + <AppShell client:only="react" />) — the
 * React CountryPage remains the full visual experience; this only adds crawlable
 * prose to the initial HTML.
 *
 * ROUTING: this file SHADOWS the [...slug].astro catch-all for /country/* (it is a
 * more specific route, so Astro serves it first). [...slug].astro is left untouched
 * and still owns /world-analysis/* and every other client route. This route mirrors
 * the catch-all's 404 behavior for non-country-code paths so nothing regresses.
 *
 * CRAWLABILITY IS GATED: the SEO prose block is emitted ONLY for countries listed in
 * SEO_READY_COUNTRIES (two-phase-regenerated + proofed). The block covers all ten
 * sections of the six-peer schema and embeds BOTH languages (lang-tagged) at the one
 * canonical URL — the React island serves both languages client-side at that URL too.
 */
import { readFileSync, existsSync } from 'fs';
import { resolve } from 'path';
import yaml from 'js-yaml';
import Base from '../../layouts/Base.astro';
import AppShell from '../../components/AppShell';
import { SEO_READY_COUNTRIES } from '../../lib/analysedCountries';

export const prerender = false;

const rawCode = String(Astro.params.cca3 ?? '');
const cca3 = rawCode.toUpperCase();
const isCountryCode = /^[A-Za-z]{2,4}$/.test(rawCode);

const yamlPath = resolve(process.cwd(), 'content', 'countries', cca3, 'analysis.yaml');
const fileExists = isCountryCode && existsSync(yamlPath);
const seoReady = fileExists && SEO_READY_COUNTRIES.includes(cca3);

// Mirror [...slug].astro: anything that isn't a plausible country code is a real 404
// (still serves the SPA so its NotFound page renders).
if (!isCountryCode) {
  Astro.response.status = 404;
}

const stripCites = (s: unknown): string =>
  String(s ?? '')
    .replace(/\[[a-z0-9-]+\]/g, '')
    .replace(/\s{2,}/g, ' ')
    // Removing a mid-sentence marker leaves " ." / " ," — collapse it. Plain
    // spaces only: French narrow-NBSP punctuation spacing must survive.
    .replace(/ +([.,])/g, '$1')
    .trim();

const parseJsonArray = (v: unknown): any[] => {
  if (Array.isArray(v)) return v;
  if (typeof v === 'string') {
    try {
      const parsed = JSON.parse(v);
      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return [];
    }
  }
  return [];
};

// Situation is the verified event layer: threads-JSON (same JSON-in-text
// convention as actors/risks) flattened to crawlable lines, or legacy prose
// split into paragraphs. ARRAY ORDER IS SEMANTIC (threads by recency of last
// activity, events chronologically forward) — never sort or reverse here.
const situationLines = (v: unknown): string[] => {
  const raw = String(v ?? '').trim();
  if (!raw) return [];
  if (raw.startsWith('[')) {
    const threads = parseJsonArray(raw);
    const lines: string[] = [];
    for (const th of threads) {
      const name = stripCites(th?.thread);
      for (const e of Array.isArray(th?.events) ? th.events : []) {
        const parts = [stripCites(e?.date), stripCites(e?.what), stripCites(e?.changed)].filter(Boolean);
        if (parts.length) lines.push(name ? `${name} — ${parts.join(' — ')}` : parts.join(' — '));
      }
      const cur = stripCites(th?.currentState);
      if (cur) lines.push(name ? `${name} — ${cur}` : cur);
    }
    return lines;
  }
  return raw.split(/\n{2,}/).map(stripCites).filter(Boolean);
};

interface LangSeo {
  snapshot: string[];
  political: string[];
  situation: string[];
  economy: string[];
  territory: string[];
  capacity: string[];
  society: string[];
  security: string[];
  actors: string[];
  risks: string[];
  sources: string[];
}

function buildLangSeo(data: Record<string, any>, lang: 'en' | 'fr'): LangSeo {
  const g = (k: string) => stripCites(data?.[`${k}_${lang}`]);
  const nonEmpty = (x: string) => x.trim().length > 2;

  const snapshot = String(data?.[`executiveSnapshot_${lang}`] ?? '')
    .split('\n')
    .map((line) => stripCites(line))
    .filter(Boolean);

  const actors = [
    ...parseJsonArray(data?.[`actors_domestic_${lang}`]),
    ...parseJsonArray(data?.[`actors_external_${lang}`]),
  ]
    .map((a) => `${stripCites(a?.name)}: ${stripCites(a?.interests)}`)
    .filter(nonEmpty);

  const risks = parseJsonArray(data?.[`risks_${lang}`])
    .map((r) => `${stripCites(r?.title)} — ${stripCites(r?.trigger)}`)
    .filter(nonEmpty);

  const sources = parseJsonArray(data?.sources)
    .map((s) =>
      lang === 'fr'
        ? `${stripCites(s?.nameFr || s?.name)} — ${stripCites(s?.descFr || s?.desc)}`
        : `${stripCites(s?.name)} — ${stripCites(s?.desc)}`
    )
    .filter(nonEmpty);

  return {
    snapshot,
    political: [
      g('political_powerStructure'),
      g('political_stabilityDrivers'),
      g('political_shockAbsorbers'),
      g('political_constitutionalSubstrate'),
    ].filter(Boolean),
    situation: situationLines(data?.[`situation_${lang}`]),
    economy: [
      g('economy_macroReality'),
      g('economy_externalVulnerability'),
      g('economy_politicalEconomy'),
    ].filter(Boolean),
    territory: [
      g('territory_geography'),
      g('territory_minerals'),
      g('territory_biosphere'),
      g('territory_climate'),
      g('territory_metabolism'),
      g('territory_transition'),
    ].filter(Boolean),
    capacity: [
      g('capacity_permitting'),
      g('capacity_delivery'),
      g('capacity_productivity'),
    ].filter(Boolean),
    society: [
      g('society_demographics'),
      g('society_composition'),
      g('society_religion'),
      g('society_cohesion'),
    ].filter(Boolean),
    security: [g('security_internal'), g('security_diplomacy')].filter(Boolean),
    actors,
    risks,
    sources,
  };
}

// Section headings per language, mirroring the React page's labels.
// FR-PLACEHOLDER: French headings — Peggy to verify.
const HEADINGS = {
  en: {
    report: 'Country Situation Report',
    exec: 'Executive Snapshot',
    political: 'Political Stability',
    situation: 'Situation',
    economy: 'Economy',
    territory: 'Territory',
    capacity: 'State Capacity',
    society: 'Society',
    security: 'Security & Diplomacy',
    actors: 'Key Actors',
    risks: 'Risk Register',
    sources: 'Sources',
  },
  fr: {
    report: 'Rapport de situation pays',
    exec: 'Synthèse exécutive',
    political: 'Stabilité politique',
    situation: 'Situation',
    economy: 'Économie',
    territory: 'Territoire',
    capacity: "Capacité de l'État",
    society: 'Société',
    security: 'Sécurité & Diplomatie',
    actors: 'Carte des acteurs',
    risks: 'Registre des risques',
    sources: 'Sources',
  },
} as const;

let seoEn: LangSeo | null = null;
let seoFr: LangSeo | null = null;
let nameEn = '';
let nameFr = '';

if (seoReady) {
  const data = yaml.load(readFileSync(yamlPath, 'utf-8')) as Record<string, any>;
  nameEn = String(data?.nameEn ?? cca3);
  nameFr = String(data?.nameFr ?? nameEn);
  seoEn = buildLangSeo(data, 'en');
  seoFr = buildLangSeo(data, 'fr');
}

const blocks = [
  { seo: seoEn, lang: 'en' as const, name: nameEn, h: HEADINGS.en },
  { seo: seoFr, lang: 'fr' as const, name: nameFr, h: HEADINGS.fr },
];

const pageTitle = seoEn
  ? `${nameEn} — Country Situation Report | TransHorizons`
  : 'TransHorizons — World Views';
const pageDesc =
  seoEn && seoEn.snapshot.length > 0
    ? seoEn.snapshot[0].slice(0, 300)
    : 'Structured country situation reports — political stability, economy, territory, capacity, society, and security.';
---

<Base title={pageTitle} description={pageDesc}>

  {seoEn && (
    <!-- Static SEO content: invisible to visitors, readable by crawlers. Emitted
         only for two-phase-verified, proofed countries (SEO_READY_COUNTRIES).
         Both languages at the one canonical URL, lang-tagged. -->
    <div style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;" aria-hidden="true">
      {blocks.map(({ seo, lang, name, h }) => seo && (
        <section lang={lang}>
          <h1>{name} — {h.report}</h1>
          {seo.snapshot.length > 0 && (
            <section>
              <h2>{h.exec}</h2>
              <ul>{seo.snapshot.map((b) => <li>{b}</li>)}</ul>
            </section>
          )}
          {seo.political.length > 0 && (
            <section>
              <h2>{h.political}</h2>
              {seo.political.map((p) => <p>{p}</p>)}
            </section>
          )}
          {seo.situation.length > 0 && (
            <section>
              <h2>{h.situation}</h2>
              <ul>{seo.situation.map((s) => <li>{s}</li>)}</ul>
            </section>
          )}
          {seo.economy.length > 0 && (
            <section>
              <h2>{h.economy}</h2>
              {seo.economy.map((p) => <p>{p}</p>)}
            </section>
          )}
          {seo.territory.length > 0 && (
            <section>
              <h2>{h.territory}</h2>
              {seo.territory.map((p) => <p>{p}</p>)}
            </section>
          )}
          {seo.capacity.length > 0 && (
            <section>
              <h2>{h.capacity}</h2>
              {seo.capacity.map((p) => <p>{p}</p>)}
            </section>
          )}
          {seo.society.length > 0 && (
            <section>
              <h2>{h.society}</h2>
              {seo.society.map((p) => <p>{p}</p>)}
            </section>
          )}
          {seo.security.length > 0 && (
            <section>
              <h2>{h.security}</h2>
              {seo.security.map((p) => <p>{p}</p>)}
            </section>
          )}
          {seo.actors.length > 0 && (
            <section>
              <h2>{h.actors}</h2>
              <ul>{seo.actors.map((a) => <li>{a}</li>)}</ul>
            </section>
          )}
          {seo.risks.length > 0 && (
            <section>
              <h2>{h.risks}</h2>
              <ul>{seo.risks.map((r) => <li>{r}</li>)}</ul>
            </section>
          )}
          {seo.sources.length > 0 && (
            <section>
              <h2>{h.sources}</h2>
              <ul>{seo.sources.map((s) => <li>{s}</li>)}</ul>
            </section>
          )}
        </section>
      ))}
    </div>
  )}

  <!-- React app: full visual experience for visitors, unchanged. -->
  <AppShell client:only="react" />

</Base>
