---
/**
 * src/pages/country/[cca3].astro
 *
 * Server-rendered SEO layer for country situation reports. COPIES the existing
 * article SSR pattern (hidden SEO div + <AppShell client:only="react" />) — the
 * React CountryPage remains the full visual experience; this only adds crawlable
 * prose to the initial HTML.
 *
 * ROUTING: this file SHADOWS the [...slug].astro catch-all for /country/* (it is a
 * more specific route, so Astro serves it first). [...slug].astro is left untouched
 * and still owns /world-analysis/* and every other client route. This route mirrors
 * the catch-all's 404 behavior for non-country-code paths so nothing regresses.
 *
 * CRAWLABILITY IS GATED: the SEO prose block is emitted ONLY for countries listed in
 * SEO_READY_COUNTRIES (two-phase-regenerated + proofed). The block covers all ten
 * sections of the six-peer schema and embeds BOTH languages (lang-tagged) at the one
 * canonical URL — the React island serves both languages client-side at that URL too.
 */
import { readFileSync, existsSync } from 'fs';
import { resolve } from 'path';
import yaml from 'js-yaml';
import Base from '../../layouts/Base.astro';
import AppShell from '../../components/AppShell';
import { SEO_READY_COUNTRIES } from '../../lib/analysedCountries';
import LegacyReveal from '../../components/LegacyReveal.astro';

export const prerender = false;

const rawCode = String(Astro.params.cca3 ?? '');
const cca3 = rawCode.toUpperCase();
const isCountryCode = /^[A-Za-z]{2,4}$/.test(rawCode);

const yamlPath = resolve(process.cwd(), 'content', 'countries', cca3, 'analysis.yaml');
const fileExists = isCountryCode && existsSync(yamlPath);
const seoReady = fileExists && SEO_READY_COUNTRIES.includes(cca3);

// Mirror [...slug].astro: anything that isn't a plausible country code is a real 404
// (still serves the SPA so its NotFound page renders).
if (!isCountryCode) {
  Astro.response.status = 404;
}

const stripCites = (s: unknown): string =>
  String(s ?? '')
    // Both marker kinds (rework §1): [source-id] citations and [dot.path] anchors.
    .replace(/\[(?:[a-z0-9-]+|[a-z][a-zA-Z0-9]*(?:\.[a-z][a-zA-Z0-9]*)+)\]/g, '')
    .replace(/\s{2,}/g, ' ')
    // Removing a mid-sentence marker leaves " ." / " ," — collapse it. Plain
    // spaces only: French narrow-NBSP punctuation spacing must survive.
    .replace(/ +([.,])/g, '$1')
    .trim();

const parseJsonArray = (v: unknown): any[] => {
  if (Array.isArray(v)) return v;
  if (typeof v === 'string') {
    try {
      const parsed = JSON.parse(v);
      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return [];
    }
  }
  return [];
};

// Situation is the verified event layer: threads-JSON (same JSON-in-text
// convention as actors/risks) flattened to crawlable lines, or legacy prose
// split into paragraphs. ARRAY ORDER IS SEMANTIC (threads by recency of last
// activity, events chronologically forward) — never sort or reverse here.
const situationLines = (v: unknown): string[] => {
  const raw = String(v ?? '').trim();
  if (!raw) return [];
  if (raw.startsWith('[')) {
    const threads = parseJsonArray(raw);
    const lines: string[] = [];
    for (const th of threads) {
      const name = stripCites(th?.thread);
      for (const e of Array.isArray(th?.events) ? th.events : []) {
        const parts = [stripCites(e?.date), stripCites(e?.what), stripCites(e?.changed)].filter(Boolean);
        if (parts.length) lines.push(name ? `${name} — ${parts.join(' — ')}` : parts.join(' — '));
      }
      const cur = stripCites(th?.currentState);
      if (cur) lines.push(name ? `${name} — ${cur}` : cur);
    }
    return lines;
  }
  return raw.split(/\n{2,}/).map(stripCites).filter(Boolean);
};

interface LangSeo {
  baseline: string[];
  territory: string[];
  society: string[];
  economy: string[];
  political: string[];
  capacity: string[];
  security: string[];
  situation: string[];
  actors: string[];
  risks: string[];
  sources: string[];
}

function buildLangSeo(data: Record<string, any>, lang: 'en' | 'fr'): LangSeo {
  const g = (k: string) => stripCites(data?.[`${k}_${lang}`]);
  // New name first, legacy fallback (rework §3 renames) — not-yet-regenerated
  // countries keep emitting their old-field prose.
  const gf = (k: string, legacy: string) => g(k) || g(legacy);

  const nonEmpty = (x: string) => x.trim().length > 2;

  const actors = [
    ...parseJsonArray(data?.[`actors_domestic_${lang}`]),
    ...parseJsonArray(data?.[`actors_external_${lang}`]),
  ]
    .map((a) => `${stripCites(a?.name)}: ${stripCites(a?.interests)}`)
    .filter(nonEmpty);

  const risks = parseJsonArray(data?.[`risks_${lang}`])
    .map((r) => `${stripCites(r?.title)} — ${stripCites(r?.trigger)}`)
    .filter(nonEmpty);

  const sources = parseJsonArray(data?.sources)
    .map((s) =>
      lang === 'fr'
        ? `${stripCites(s?.nameFr || s?.name)} — ${stripCites(s?.descFr || s?.desc)}`
        : `${stripCites(s?.name)} — ${stripCites(s?.desc)}`
    )
    .filter(nonEmpty);

  // Rework §5 order: Baseline; Territory · Society · Economy · Political Order ·
  // Capacity to Deliver · Security & Diplomacy; Situation · Actors · Risks.
  // Executive snapshot REMOVED (its content lives in the section openers).
  return {
    baseline: [g('baseline')].filter(Boolean),
    territory: [
      g('territory_geography'),
      g('territory_biosphere'),
      g('territory_minerals'),
      g('territory_climate'),
      g('territory_metabolism'),
      g('territory_transition'),
    ].filter(Boolean),
    society: [
      g('society_demographics'),
      g('society_composition'),
      g('society_language'),
      g('society_religion'),
      g('society_wellbeing'),
      g('society_cohesion'),
    ].filter(Boolean),
    economy: [
      gf('economy_realEconomy', 'economy_macroReality'),
      g('economy_publicFinances'),
      g('economy_externalVulnerability'),
      g('economy_politicalEconomy'),
    ].filter(Boolean),
    political: [
      g('political_powerStructure'),
      g('political_rightsAndChecks'),
      g('political_stabilityDrivers'),
      g('political_shockAbsorbers'),
      g('political_constitutionalSubstrate'),
      g('political_stateStructure'),
    ].filter(Boolean),
    capacity: [
      g('capacity_inheritedTerrain'),
      g('capacity_steering'),
      gf('capacity_approvals', 'capacity_permitting'),
      g('capacity_delivery'),
      g('capacity_publicServices'),
      g('capacity_productivity'),
    ].filter(Boolean),
    security: [
      g('security_posture'),
      g('security_internal'),
      g('security_military'),
      g('security_transnationalExposure'),
      g('security_diplomacy'),
    ].filter(Boolean),
    situation: situationLines(data?.[`situation_${lang}`]),
    actors,
    risks,
    sources,
  };
}

// Section headings per language, mirroring the React page's labels.
// FR-PLACEHOLDER: French headings — Peggy to verify.
const HEADINGS = {
  en: {
    report: 'Country Situation Report',
    baseline: 'Baseline',
    political: 'Political Order',
    situation: 'Situation',
    economy: 'Economy',
    territory: 'Territory',
    capacity: 'Capacity to Deliver',
    society: 'Society',
    security: 'Security & Diplomacy',
    actors: 'Key Actors',
    risks: 'Risk Register',
    sources: 'Sources',
  },
  fr: {
    report: 'Rapport de situation pays',
    baseline: 'État des lieux',
    political: 'Ordre politique',
    situation: 'Situation',
    economy: 'Économie',
    territory: 'Territoire',
    capacity: 'Capacité de mise en œuvre',
    society: 'Société',
    security: 'Sécurité & Diplomatie',
    actors: 'Carte des acteurs',
    risks: 'Registre des risques',
    sources: 'Sources',
  },
} as const;

let seoEn: LangSeo | null = null;
let seoFr: LangSeo | null = null;
let nameEn = '';
let nameFr = '';
let situationUpdated = '';

if (seoReady) {
  const data = yaml.load(readFileSync(yamlPath, 'utf-8')) as Record<string, any>;
  nameEn = String(data?.nameEn ?? cca3);
  nameFr = String(data?.nameFr ?? nameEn);
  situationUpdated = String(data?.situation_lastUpdated ?? '');
  seoEn = buildLangSeo(data, 'en');
  seoFr = buildLangSeo(data, 'fr');
}

const blocks = [
  { seo: seoEn, lang: 'en' as const, name: nameEn, h: HEADINGS.en },
  { seo: seoFr, lang: 'fr' as const, name: nameFr, h: HEADINGS.fr },
];

// Ordered sections for the old-browser reading view — mirrors the six-peer
// schema plus snapshot / situation / actors / risks / sources. `type` picks a
// bullet list vs prose paragraphs; `risks` flags the caveat below.
type ReadingSection = { title: string; items: string[]; type: 'list' | 'prose'; risks?: boolean };
const readingSections = (seo: LangSeo, h: typeof HEADINGS.en): ReadingSection[] =>
  // Rework §5 order: Baseline; standing body Territory → Security; dynamic tail.
  ([
    { title: h.baseline, items: seo.baseline, type: 'prose' },
    { title: h.territory, items: seo.territory, type: 'prose' },
    { title: h.society, items: seo.society, type: 'prose' },
    { title: h.economy, items: seo.economy, type: 'prose' },
    { title: h.political, items: seo.political, type: 'prose' },
    { title: h.capacity, items: seo.capacity, type: 'prose' },
    { title: h.security, items: seo.security, type: 'prose' },
    { title: h.situation, items: seo.situation, type: 'list' },
    { title: h.actors, items: seo.actors, type: 'list' },
    { title: h.risks, items: seo.risks, type: 'list', risks: true },
    { title: h.sources, items: seo.sources, type: 'list' },
  ] as ReadingSection[]).filter((s) => s.items && s.items.length > 0);

// Risk-register caveat mirrors the visible page (framing under redesign).
// FR-PLACEHOLDER: French wording awaits Peggy's review.
const riskNotice = {
  en: 'Under redesign — current entries reflect an outdated framing.',
  fr: 'Section en cours de remaniement — les entrées actuelles reflètent un cadrage obsolète.',
} as const;

const pageTitle = seoEn
  ? `${nameEn} — Country Situation Report | TransHorizons`
  : 'TransHorizons — World Views';
const pageDesc =
  seoEn && seoEn.baseline.length > 0
    ? seoEn.baseline[0].slice(0, 300)
    : 'Structured country situation reports — territory, society, economy, political order, capacity to deliver, and security.';
---

<Base title={pageTitle} description={pageDesc}>

  {seoEn && (
    <!-- Static SEO content: invisible to visitors, readable by crawlers. Emitted
         only for two-phase-verified, proofed countries (SEO_READY_COUNTRIES).
         Both languages at the one canonical URL, lang-tagged. -->
    <div style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;" aria-hidden="true">
      {blocks.map(({ seo, lang, name, h }) => seo && (
        <section lang={lang}>
          <h1>{name} — {h.report}</h1>
          {seo.baseline.length > 0 && (
            <section>
              <h2>{h.baseline}</h2>
              {seo.baseline.map((p) => <p>{p}</p>)}
            </section>
          )}
          {seo.territory.length > 0 && (
            <section>
              <h2>{h.territory}</h2>
              {seo.territory.map((p) => <p>{p}</p>)}
            </section>
          )}
          {seo.society.length > 0 && (
            <section>
              <h2>{h.society}</h2>
              {seo.society.map((p) => <p>{p}</p>)}
            </section>
          )}
          {seo.economy.length > 0 && (
            <section>
              <h2>{h.economy}</h2>
              {seo.economy.map((p) => <p>{p}</p>)}
            </section>
          )}
          {seo.political.length > 0 && (
            <section>
              <h2>{h.political}</h2>
              {seo.political.map((p) => <p>{p}</p>)}
            </section>
          )}
          {seo.capacity.length > 0 && (
            <section>
              <h2>{h.capacity}</h2>
              {seo.capacity.map((p) => <p>{p}</p>)}
            </section>
          )}
          {seo.security.length > 0 && (
            <section>
              <h2>{h.security}</h2>
              {seo.security.map((p) => <p>{p}</p>)}
            </section>
          )}
          {seo.situation.length > 0 && (
            <section>
              <h2>{h.situation}</h2>
              {/* FR-PLACEHOLDER: French label awaits Peggy's review. */}
              {!!situationUpdated && (
                <p><em>{lang === 'fr' ? `Vérifié le ${situationUpdated}` : `Verified ${situationUpdated}`}</em></p>
              )}
              <ul>{seo.situation.map((s) => <li>{s}</li>)}</ul>
            </section>
          )}
          {seo.actors.length > 0 && (
            <section>
              <h2>{h.actors}</h2>
              <ul>{seo.actors.map((a) => <li>{a}</li>)}</ul>
            </section>
          )}
          {seo.risks.length > 0 && (
            <section>
              <h2>{h.risks}</h2>
              {/* Mirrors the visible-page notice. FR-PLACEHOLDER: French wording awaits Peggy's review. */}
              <p><em>{lang === 'fr'
                ? 'Section en cours de remaniement — les entrées actuelles reflètent un cadrage obsolète.'
                : 'Under redesign — current entries reflect an outdated framing.'}</em></p>
              <ul>{seo.risks.map((r) => <li>{r}</li>)}</ul>
            </section>
          )}
          {seo.sources.length > 0 && (
            <section>
              <h2>{h.sources}</h2>
              <ul>{seo.sources.map((s) => <li>{s}</li>)}</ul>
            </section>
          )}
        </section>
      ))}
    </div>
  )}

  <!-- Old-browser reading view (see components/LegacyReveal.astro). Hidden
       unless the React app can't run. GATED to seoReady countries (Canada only
       right now) so unreviewed reports never surface here. Reuses buildLangSeo
       output, so it tracks the .astro SEO layer, not the React page. -->
  {seoReady && (
    <LegacyReveal>
      <p class="thf-kicker">Country situation report — Reading view</p>
      <p class="thf-lang"><a href="#thc-en">English</a> · <a href="#thc-fr">Français</a></p>
      {blocks.map(({ seo, lang, name, h }) => seo && (
        <section id={`thc-${lang}`} lang={lang}>
          <h1>{name} — {h.report}</h1>
          {readingSections(seo, h).map((sec) => (
            <div>
              <h2 class="thf-h2">{sec.title}</h2>
              {sec.risks && <p class="thf-note">{lang === 'fr' ? riskNotice.fr : riskNotice.en}</p>}
              {sec.type === 'list'
                ? <ul class="thf-list">{sec.items.map((it) => <li>{it}</li>)}</ul>
                : sec.items.map((it) => <p class="thf-p">{it}</p>)}
            </div>
          ))}
        </section>
      ))}
      <p class="thf-foot"><a href="/">← Home · Accueil</a></p>
    </LegacyReveal>
  )}

  <!-- React app: full visual experience for visitors, unchanged. -->
  <AppShell client:only="react" />

</Base>
