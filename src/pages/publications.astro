---
// src/pages/publications.astro
import Base from '../layouts/Base.astro';
import AppShell from '../components/AppShell';
import raw from '../../content/pages/publications.yaml';
export const prerender = false;

// Single source of truth: content/pages/publications.yaml — the same file the React page
// (Publications.tsx) reads. Both the EN and FR SEO blocks below are rendered from it, so the
// crawlable text and the visible page can never drift. Both languages ship in the raw HTML
// (visually hidden) so search engines see them without running JS. Mirrors the research-approach
// pattern; here both languages are YAML-driven (research-approach left its EN block hardcoded).
const data = raw as Record<string, any>;
const en = data.en;
const fr = data.fr;
const paras = (s: string) => (s ?? '').split(/\n+/).map((x) => x.trim()).filter(Boolean);

const blocks = [
  { c: en, lang: 'en', booksHeading: 'Published Translations',
    nav: [['/', 'Home'], ['/about', 'About'], ['/analyses', 'Analyses']] },
  { c: fr, lang: 'fr', booksHeading: 'Traductions publiées',
    nav: [['/', 'Accueil'], ['/about', 'À propos'], ['/analyses', 'Analyses']] },
];
---
<Base title={`${en.title} — TransHorizons`} description={en.metaDescription}>
  {blocks.map(({ c, lang, booksHeading, nav }) => (
    <div lang={lang} style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;" aria-hidden="true">
      <h1>{c.title}</h1>
      {paras(c.intro).map((p: string) => (<p>{p}</p>))}
      <nav>
        {nav.map(([href, label]: string[]) => (<a href={href}>{label}</a>))}
      </nav>
      <section>
        <h2>{c.prize.name}</h2>
        <p>{c.prize.desc}</p>
      </section>
      <section>
        <h2>{booksHeading}</h2>
        <ul>
          {c.books.map((b: any) => (
            <li>
              <h3>{b.title}</h3>
              <p>{b.publisher}{b.year ? ` · ${b.year}` : ''}</p>
              <p>{b.isbn}</p>
              <p>{b.desc}</p>
            </li>
          ))}
        </ul>
      </section>
    </div>
  ))}
  <AppShell client:only="react" />
</Base>
