---
// src/pages/about.astro
// Standalone, fully server-rendered About page — crawlable by Google
// Mirrors the content of AboutSection.tsx / LanguageContext translations
// Interactive elements (EN/FR toggle) handled via a small inline script

const ABOUT_IMAGE = '/images/about_portrait-LYRozAghmFTyLmT3pDWY6n.webp';
// Canonical origin from astro.config `site` (single source of truth).
const canonicalHref = new URL('/about', Astro.site ?? 'https://transhorizons.net').href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>About — TransHorizons | Peggy Brenier</title>
    <meta name="description" content="Independent research on Canadian resource geopolitics, trade, and strategic systems. Senior translator with more than twenty years supporting Canadian federal institutions including Statistics Canada and Natural Resources Canada. Independent research on geopolitics, resource systems, and technological transformation." />
    <link rel="canonical" href={canonicalHref} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,300;0,400;0,500;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: 'Inter', sans-serif; background: #141414; color: #fff; }
      a { color: inherit; text-decoration: none; }

      /* Navbar */
      nav { display: flex; align-items: center; justify-content: space-between; padding: 1.25rem 2.5rem; border-bottom: 1px solid rgba(255,255,255,0.08); }
      .nav-logo { font-family: 'Playfair Display', serif; font-size: 1.25rem; color: #fff; }
      .nav-links { display: flex; gap: 2rem; font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.6); }
      .nav-links a:hover { color: #fff; }
      .lang-toggle { display: flex; gap: 0.5rem; font-size: 0.75rem; letter-spacing: 0.05em; }
      .lang-toggle button { background: none; border: none; cursor: pointer; color: rgba(255,255,255,0.4); padding: 0; }
      .lang-toggle button.active { color: #fff; }

      /* Main layout */
      main { max-width: 1280px; margin: 0 auto; padding: 4rem 2.5rem; }

      /* Header */
      .page-header { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 3rem; }
      .accent-line { width: 1.5rem; height: 1px; background: #7D1A2E; }
      h1 { font-family: 'Playfair Display', serif; font-size: clamp(2.5rem, 5vw, 3.5rem); font-weight: 300; color: #fff; line-height: 1.15; }
      .positioning { font-size: 0.875rem; color: rgba(255,255,255,0.5); max-width: 24rem; line-height: 1.6; }

      /* Content grid */
      .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start; }
      @media (max-width: 768px) {
        .grid { grid-template-columns: 1fr; }
        nav { flex-wrap: wrap; gap: 1rem; }
        .nav-links { display: none; }
        /* Stack the right column so all text sits above the image; stats stay last. */
        .right-col { display: flex; flex-direction: column; }
        .right-col .image-wrapper { order: 4; margin-top: 2rem; }
        .right-col #about-aside { order: 1; }
        .right-col .cv-note { order: 2; }
        .right-col .buttons { order: 3; }
        .right-col .stats { order: 5; }
      }

      /* Left column */
      .divider { width: 3rem; height: 1px; background: #7D1A2E; margin-bottom: 2rem; }
      .intro { font-size: 1.05rem; line-height: 1.75; color: rgba(255,255,255,0.8); border-left: 2px solid rgba(125,26,46,0.5); padding-left: 1rem; font-style: italic; margin-bottom: 2.5rem; white-space: pre-line; }
      h3 { font-family: 'Playfair Display', serif; font-size: 1.1rem; font-weight: 500; color: #fff; margin-bottom: 1rem; }
      ul { list-style: none; margin-bottom: 2.5rem; }
      ul li { display: flex; gap: 0.75rem; font-size: 0.9rem; color: rgba(255,255,255,0.7); line-height: 1.6; margin-bottom: 0.75rem; }
      ul li .bullet { color: #7D1A2E; font-weight: bold; flex-shrink: 0; margin-top: 0.15rem; }
      .research-text { font-size: 0.9rem; color: rgba(255,255,255,0.7); line-height: 1.7; }
      .lead { font-size: 1.05rem; line-height: 1.75; color: rgba(255,255,255,0.8); border-left: 2px solid rgba(125,26,46,0.5); padding-left: 1rem; margin-bottom: 1.5rem; }
      .credential { font-size: 0.95rem; line-height: 1.6; color: rgba(255,255,255,0.7); font-style: italic; margin-bottom: 1.5rem; }
      .body-text { font-size: 1.05rem; line-height: 1.75; color: rgba(255,255,255,0.8); margin-bottom: 1.5rem; }
      .inline-link { color: #7D1A2E; text-decoration: underline; text-underline-offset: 2px; }
      .inline-link:hover { color: #fff; }
      .earlier-books { margin-top: 2rem; font-size: 0.875rem; font-style: italic; line-height: 1.6; color: rgba(255,255,255,0.55); }
      .working-langs { margin-top: 0.75rem; font-size: 0.875rem; line-height: 1.7; color: rgba(255,255,255,0.7); }

      /* Right column */
      .image-wrapper { position: relative; }
      .image-border-outer { position: absolute; top: -1.25rem; right: -1.25rem; width: 100%; height: 100%; border: 1px solid rgba(125,26,46,0.25); pointer-events: none; }
      .image-border-inner { position: absolute; top: -0.625rem; right: -0.625rem; width: 100%; height: 100%; border: 1px solid rgba(125,26,46,0.1); pointer-events: none; }
      .portrait { width: 100%; height: 500px; object-fit: cover; display: block; position: relative; z-index: 1; }
      .caption { margin-top: 1.25rem; display: flex; gap: 0.75rem; align-items: flex-start; }
      .caption-line { width: 1px; height: 2.5rem; background: #7D1A2E; flex-shrink: 0; margin-top: 0.1rem; }
      .caption-text { font-size: 0.75rem; color: rgba(255,255,255,0.5); font-style: italic; line-height: 1.6; }

      /* Buttons */
      .buttons { margin-top: 2rem; display: flex; flex-wrap: wrap; gap: 0.75rem; }
      .btn-outline { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.5rem 1rem; border: 1px solid #7D1A2E; color: #7D1A2E; font-size: 0.75rem; letter-spacing: 0.05em; transition: all 0.3s; }
      .btn-outline:hover { background: #7D1A2E; color: #fff; }
      .btn-link { font-size: 0.75rem; color: #7D1A2E; letter-spacing: 0.05em; transition: color 0.3s; align-self: center; }
      .btn-link:hover { color: #fff; }
      .cv-note { margin-top: 2rem; font-size: 0.875rem; color: rgba(255,255,255,0.55); line-height: 1.6; }
      .cv-note a { color: #7D1A2E; text-decoration: underline; text-underline-offset: 2px; }
      .cv-note a:hover { color: #fff; }

      /* Stats */
      .stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-top: 2rem; padding-top: 2rem; border-top: 1px solid rgba(255,255,255,0.08); }
      .stat-number { font-family: 'Playfair Display', serif; font-size: 2.2rem; color: #7D1A2E; font-weight: 300; line-height: 1; margin-bottom: 0.5rem; }
      .stat-label { font-size: 0.625rem; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.3); line-height: 1.4; }

      /* Footer */
      footer { border-top: 1px solid rgba(255,255,255,0.08); padding: 2rem 2.5rem; display: flex; justify-content: space-between; align-items: center; font-size: 0.75rem; color: rgba(255,255,255,0.3); }
    </style>
  </head>
  <body>

    <!-- Crawlable French SEO mirror of the About bio. Canonical text copied verbatim
         from AboutSection.tsx / LanguageContext (the live FR render). Visually hidden
         so the interactive page below (EN default + EN/FR toggle) is unchanged, but
         search engines see the full French without running JS. Keep in sync with
         AboutSection.tsx if the French is revised. -->
    <div lang="fr" aria-hidden="true" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;">
      <h1>À propos de TransHorizons</h1>
      <p>Recherche indépendante sur la géopolitique des ressources, le commerce et les enjeux stratégiques du Canada.</p>
      <p>Traductrice professionnelle bilingue (EN/ES → FR) autonome établie à Montréal depuis vingt-quatre ans, après trois ans à l'interne chez Microsoft à Dublin. Contrats de traduction, de révision et de postédition concernant majoritairement le secteur fédéral canadien depuis 2010 (et presque exclusivement depuis 2017) : Statistique Canada, Ressources naturelles Canada et Environnement et Changement climatique Canada, etc.</p>
      <p><em>Agrément OTTIAQ · Cote de sécurité du gouvernement du Canada.</em></p>
      <p>Ce site Web de recherche indépendante est le prolongement de ce travail. Plus de dix ans d'exposition soutenue à du contenu institutionnel canadien (statistique, environnemental, économique, réglementaire) m'ont permis d'accumuler un certain regard sur la façon dont le pays se raconte, ce qu'il mesure ou ne mesure pas, et là où des enjeux structurels demeurent. Les articles publiés ici transposent une partie de ces perspectives sur des questions qu'il me semble important d'explorer : les minéraux critiques et la transition énergétique, la place du Canada dans un monde multipolaire, le carbone forestier, la gouvernance de l'IA, les infrastructures commerciales, etc.</p>
      <p>Ces recherches s'appuient sur un cursus initialement scientifique avant une formation en traduction et en interprétation (UCO/IPLV, Angers), un retour aux sciences à l'Université Concordia (sciences physiques, astronomie, écologie, anthropologie, histoire des sciences et des technologies) et trois ans de localisation de logiciels chez Microsoft (Dublin) à la fin des années 1990, enrichis de longs voyages en Asie, dans les Amériques, en Europe et en Océanie.</p>
      <p><em>Traductions de livres et travaux crédités antérieurs : <a href="/publications">Traductions et publications</a></em></p>
      <p>Langues de travail : français (langue maternelle), anglais (bilingue), espagnol (avancé). Connaissances complémentaires acquises par l'étude et les voyages : russe, mandarin, japonais et coréen.</p>
      <p>CV disponible sur demande par courriel à : <a href="mailto:contact@transhorizons.net">contact@transhorizons.net</a></p>
      <p>Fragments de voyage →</p>
      <p>25+ Années d'expertise · 15+ Années de traductions pour le gouvernement canadien</p>
    </div>

    <nav>
      <a href="/" class="nav-logo">TransHorizons</a>
      <div class="nav-links">
        <a href="/analyses">Analyses</a>
        <a href="/world-analysis">Maps</a>
        <a href="/research-approach">Research Approach</a>
        <a href="/notes">Notes & Reflections</a>
        <a href="/about" style="color:#fff">About</a>
      </div>
      <div class="lang-toggle">
        <button id="btn-en" class="active" onclick="setLang('en')">EN</button>
        <span style="color:rgba(255,255,255,0.2)">|</span>
        <button id="btn-fr" onclick="setLang('fr')">FR</button>
      </div>
    </nav>

    <main>
      <div class="page-header">
        <div class="accent-line"></div>
        <h1 id="story-title">About TransHorizons</h1>
        <p class="positioning" id="story-positioning">Independent research on Canadian resource geopolitics, trade, and strategic systems.</p>
      </div>

      <div class="grid">

        <!-- Left: Text -->
        <div>
          <div class="divider"></div>

          <!-- About body. Default render = English. The EN/FR toggle swaps the whole
               block via innerHTML (see bodyHtml in the script) so italics + the inline
               link survive. FR is Peggy's French (provided 2026-06-19). -->
          <div id="about-body">
            <p class="lead">Senior EN/ES → FR freelance translator based in Montréal, with 24 years of practice after three years in-house at Microsoft Dublin. Since 2010, my work has focused overwhelmingly on Canadian federal content (and almost exclusively since 2017): translation, revision, and post-editing for end-clients including Statistics Canada, Natural Resources Canada, Environment and Climate Change Canada, etc.</p>

            <p class="credential"><em>OTTIAQ-certified · Government of Canada security clearance.</em></p>

            <p class="body-text">This website is the independent research extension of that work. More than a decade of sustained exposure to Canadian institutional output — statistical, environmental, economic, regulatory — have given me a particular angle on how the country talks about itself, what it does and doesn't measure, and where the structural questions sit. The articles here take up some of the questions that strike me as worth working on: critical minerals and the energy transition, Canada's place in a multipolar system, forest carbon, AI governance, trade infrastructure, etc.</p>

            <p class="body-text">The research draws on a scientific track through high school before a pivot to languages, training in translation and interpretation (UCO/IPLV, Angers), an exchange year in sciences at Concordia (physics, astronomy, environment science, anthropology, history of science and technology), and three years of software localization at Microsoft Dublin during the late-1990s, combined with extended travel across Asia, the Americas, Europe, and Oceania, often for months at a time.</p>
          </div>
        </div>

        <!-- Right: Image + buttons + stats -->
        <div class="right-col">
          <div class="image-wrapper">
            <div class="image-border-outer"></div>
            <div class="image-border-inner"></div>
            <img src={ABOUT_IMAGE} alt="Languages, maps and global analysis — TransHorizons" class="portrait" loading="eager" />
          </div>

          <!-- Working languages + earlier book translations — moved here to rebalance.
               EN is Peggy's; the FR "earlier book" line is an AI draft (FR-PLACEHOLDER). -->
          <div id="about-aside">
            <p class="earlier-books"><em>Earlier book translations and credited work: <a href="/publications" class="inline-link">Writing &amp; Translation Archive</a></em></p>
            <p class="working-langs">Working languages: French (native), English (bilingual), Spanish (advanced). Additional study- and travel-based knowledge in Russian, Mandarin, Japanese, and Korean.</p>
          </div>

          <p class="cv-note">
            <span id="btn-cv">Full CV available on request — please email</span>
            <a href="mailto:contact@transhorizons.net">contact@transhorizons.net</a>
          </p>

          <div class="buttons">
            <a href="/notes/travel-observation" class="btn-link" id="btn-journeys">Journeys & Field Notes →</a>
          </div>

          <div class="stats">
            <div>
              <div class="stat-number">25+</div>
              <div class="stat-label" id="stat-years">Years of expertise overall</div>
            </div>
            <div>
              <div class="stat-number">15+</div>
              <div class="stat-label" id="stat-gov">Years of translations for the Canadian government</div>
            </div>
          </div>
        </div>

      </div>
    </main>

    <footer>
      <span>© 2026 TransHorizons</span>
      <span>Montreal · Canada · Global</span>
    </footer>

    <!-- is:inline keeps this verbatim in the HTML so setLang() stays a global the
         onclick handlers can reach (Astro otherwise hoists it into a module chunk). -->
    <script is:inline>
      const translations = {
        en: {
          'story-title': 'About TransHorizons',
          'story-positioning': 'Independent research on Canadian resource geopolitics, trade, and strategic systems.',
          'stat-years': 'Years of expertise overall',
          'stat-gov': 'Years of translations for the Canadian government',
          'btn-cv': 'Full CV available on request — please email',
          'btn-journeys': 'Journeys & Field Notes (in progress) →',
        },
        fr: {
          'story-title': 'À propos de TransHorizons',
          'story-positioning': 'Recherche indépendante sur la géopolitique des ressources, le commerce et les enjeux stratégiques du Canada.',
          'stat-years': 'Années d\'expertise',
          'stat-gov': 'Années de traductions pour le gouvernement canadien',
          'btn-cv': 'CV disponible sur demande par courriel à :',
          'btn-journeys': 'Fragments de voyage (en développement) →',
        }
      };

      // About-body HTML per language. Swapped via innerHTML so the italics + inline
      // link survive (textContent would flatten them). FR is Peggy's French (2026-06-19).
      const bodyHtml = {
        en: `
          <p class="lead">Senior EN/ES → FR freelance translator based in Montréal, with 24 years of practice after three years in-house at Microsoft Dublin. Since 2010, my work has focused overwhelmingly on Canadian federal content (and almost exclusively since 2017): translation, revision, and post-editing for end-clients including Statistics Canada, Natural Resources Canada, Environment and Climate Change Canada, etc.</p>
          <p class="credential"><em>OTTIAQ-certified · Government of Canada security clearance.</em></p>
          <p class="body-text">This website is the independent research extension of that work. More than a decade of sustained exposure to Canadian institutional output — statistical, environmental, economic, regulatory — have given me a particular angle on how the country talks about itself, what it does and doesn't measure, and where the structural questions sit. The articles here take up some of the questions that strike me as worth working on: critical minerals and the energy transition, Canada's place in a multipolar system, forest carbon, AI governance, trade infrastructure, etc.</p>
          <p class="body-text">The research draws on a scientific track through high school before a pivot to languages, training in translation and interpretation (UCO/IPLV, Angers), an exchange year in sciences at Concordia (physics, astronomy, environment science, anthropology, history of science and technology), and three years of software localization at Microsoft Dublin during the late-1990s, combined with extended travel across Asia, the Americas, Europe, and Oceania, often for months at a time.</p>
        `,
        fr: `
          <p class="lead">Traductrice professionnelle bilingue (EN/ES → FR) autonome établie à Montréal depuis vingt-quatre ans, après trois ans à l'interne chez Microsoft à Dublin. Contrats de traduction, de révision et de postédition concernant majoritairement le secteur fédéral canadien depuis 2010 (et presque exclusivement depuis 2017) : Statistique Canada, Ressources naturelles Canada et Environnement et Changement climatique Canada, etc.</p>
          <p class="credential"><em>Agrément OTTIAQ · Cote de sécurité du gouvernement du Canada.</em></p>
          <p class="body-text">Ce site Web de recherche indépendante est le prolongement de ce travail. Plus de dix ans d'exposition soutenue à du contenu institutionnel canadien (statistique, environnemental, économique, réglementaire) m'ont permis d'accumuler un certain regard sur la façon dont le pays se raconte, ce qu'il mesure ou ne mesure pas, et là où des enjeux structurels demeurent. Les articles publiés ici transposent une partie de ces perspectives sur des questions qu'il me semble important d'explorer : les minéraux critiques et la transition énergétique, la place du Canada dans un monde multipolaire, le carbone forestier, la gouvernance de l'IA, les infrastructures commerciales, etc.</p>
          <p class="body-text">Ces recherches s'appuient sur un cursus initialement scientifique avant une formation en traduction et en interprétation (UCO/IPLV, Angers), un retour aux sciences à l'Université Concordia (sciences physiques, astronomie, écologie, anthropologie, histoire des sciences et des technologies) et trois ans de localisation de logiciels chez Microsoft (Dublin) à la fin des années 1990, enrichis de longs voyages en Asie, dans les Amériques, en Europe et en Océanie.</p>
        `
      };

      // Under-image aside (working languages + earlier book translations). Swapped via
      // innerHTML so the link survives. FR "earlier book" line is an AI draft: FR-PLACEHOLDER.
      const asideHtml = {
        en: `
          <p class="earlier-books"><em>Earlier book translations and credited work: <a href="/publications" class="inline-link">Writing &amp; Translation Archive</a></em></p>
          <p class="working-langs">Working languages: French (native), English (bilingual), Spanish (advanced). Additional study- and travel-based knowledge in Russian, Mandarin, Japanese, and Korean.</p>
        `,
        fr: `
          <p class="earlier-books"><em>Traductions de livres et travaux crédités antérieurs : <a href="/publications" class="inline-link">Traductions et publications</a></em></p>
          <p class="working-langs">Langues de travail : français (langue maternelle), anglais (bilingue), espagnol (avancé). Connaissances complémentaires acquises par l'étude et les voyages : russe, mandarin, japonais et coréen.</p>
        `
      };

      function setLang(lang) {
        const t = translations[lang];
        document.getElementById('btn-en').classList.toggle('active', lang === 'en');
        document.getElementById('btn-fr').classList.toggle('active', lang === 'fr');

        for (const [id, value] of Object.entries(t)) {
          const el = document.getElementById(id);
          if (el) el.textContent = value;
        }

        const body = document.getElementById('about-body');
        if (body && bodyHtml[lang]) body.innerHTML = bodyHtml[lang];

        const aside = document.getElementById('about-aside');
        if (aside && asideHtml[lang]) aside.innerHTML = asideHtml[lang];

        document.documentElement.lang = lang;
      }
    </script>

  </body>
</html>
