---
// src/pages/research-approach.astro
import Base from '../layouts/Base.astro';
import AppShell from '../components/AppShell';
import raw from '../../content/pages/research-approach.yaml';
export const prerender = false;

// Single source of truth: content/pages/research-approach.yaml — the same file the React
// page (ResearchApproach.tsx) reads. BOTH the EN and FR crawlable blocks below are rendered
// from it by one shared template, so the text a fetcher receives can never drift from the
// text a reader sees, in either language.
//
// This used to hold a hand-maintained English block while only the French was YAML-driven.
// That drifted: the third `tools.outro` paragraph ("The use of AI expands the capacity...")
// was added to the content and never carried into the English copy, so crawlers got a
// truncated "Use of Analytical Tools" section in English while the French was complete.
// Section order below follows ResearchApproach.tsx exactly. `traceability` and `referencing`
// exist in the YAML but the React page does not render them, so the mirrors don't either —
// keep that in step if the component starts rendering them.
const data = raw as Record<string, any>;
const en = data.en;
const fr = data.fr;

const paras = (s: string) => (s ?? '').split(/\n+/).map((x) => x.trim()).filter(Boolean);
const listItems = (s: string) =>
  (s ?? '').split(/\n|;/).map((x) => x.trim().replace(/;+$/, '')).filter(Boolean);

const blocks = [
  {
    c: en,
    lang: 'en',
    nav: [['/', 'Home'], ['/analyses', 'Analyses'], ['/notes', 'Notes & Reflections'], ['/about', 'About']],
  },
  {
    c: fr,
    lang: 'fr',
    nav: [['/', 'Accueil'], ['/analyses', 'Analyses'], ['/notes', 'Notes et réflexions'], ['/about', 'À propos']],
  },
];

// Page-specific meta description, derived from the same YAML so it cannot drift either.
const metaDescription = paras(en.method.body)[0];
---
<Base title={`${en.method.heading} — TransHorizons`} description={metaDescription}>
  {blocks.map(({ c, lang, nav }) => (
    <div lang={lang} style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;" aria-hidden="true">
      <h1>{c.method.heading}</h1>
      {paras(c.method.body).map((p: string) => (<p>{p}</p>))}
      <nav>
        {nav.map(([href, label]: string[]) => (<a href={href}>{label}</a>))}
      </nav>

      <section>
        <h2>{c.scope.heading}</h2>
        <p>{c.scope.intro}</p>
        <ul>{c.scope.items.map((it: any) => (<li><strong>{it.title}</strong> — {it.desc}</li>))}</ul>
        <p>{c.scope.closing}</p>
      </section>

      <section>
        <h2>{c.sources.heading}</h2>
        <p>{c.sources.intro}</p>
        <ul>{listItems(c.sources.items).map((it: string) => (<li>{it}</li>))}</ul>
        <p>{c.sources.closing}</p>
      </section>

      <section>
        <h2>{c.principles.heading}</h2>
        <p>{c.principles.intro}</p>
        <ul>{c.principles.items.map((it: any) => (<li><strong>{it.title}</strong> — {it.desc}</li>))}</ul>
      </section>

      <section>
        <h2>{c.mapping.heading}</h2>
        {paras(c.mapping.body).map((p: string) => (<p>{p}</p>))}
        <ul>{listItems(c.mapping.items).map((it: string) => (<li>{it}</li>))}</ul>
        <p>{c.mapping.closing}</p>
      </section>

      <section>
        <h2>{c.process.heading}</h2>
        <p>{c.process.intro}</p>
        <ul>{c.process.items.map((it: any) => (<li><strong>{it.bold}</strong>{it.rest}</li>))}</ul>
        <p>{c.process.closing}</p>
      </section>

      <section>
        <h2>{c.limits.heading}</h2>
        {paras(c.limits.body).map((p: string) => (<p>{p}</p>))}
        <ul>{listItems(c.limits.items).map((it: string) => (<li>{it}</li>))}</ul>
        <p>{c.limits.closing}</p>
      </section>

      <section>
        <h2>{c.tools.heading}</h2>
        {paras(c.tools.intro).map((p: string) => (<p>{p}</p>))}
        <ul>{listItems(c.tools.usedItems).map((it: string) => (<li>{it}</li>))}</ul>
        <p>{c.tools.p3}</p>
        <ul>{listItems(c.tools.howeverItems).map((it: string) => (<li>{it}</li>))}</ul>
        {paras(c.tools.outro).map((p: string) => (<p>{p}</p>))}
      </section>

      <section>
        <h2>{c.position.heading}</h2>
        {paras(c.position.body).map((p: string) => (<p>{p}</p>))}
      </section>
    </div>
  ))}

  <AppShell client:only="react" />
</Base>
