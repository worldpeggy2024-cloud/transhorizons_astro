---
// src/pages/analyses.astro
import Base from '../layouts/Base.astro';
import AppShell from '../components/AppShell';
import { readFileSync } from 'fs';
import { resolve } from 'path';
import yaml from 'js-yaml';
export const prerender = false;

// French SEO mirror of the analyses list. Titles/subtitles/categories pulled from the
// article YAMLs (Peggy's reviewed French) so the list never drifts. A French subtitle is
// shown only when a real translation exists (subtitle_fr differs from subtitle_en) — this
// skips entries whose FR subtitle is still the English placeholder (e.g. AI Governance).
const analysesOrder: [string, string][] = [
  ['resource-civilization', '2026-04_Resource-Civilization_Essay'],
  ['canada-multipolar', '2026-03_Canada-Multipolar_Essay'],
  ['critical-minerals', '2026-02_Critical-Minerals_Essay'],
  ['ai-governance', '2026-01_AI-Governance_Essay'],
  ['canada-forest-system-climate-industrial-pressure', '2026-04_Canada-Forest-System_Essay'],
  ['canada-forest-carbon', '2026-04_Canada-Forest-Carbon_Essay'],
  ['canada-resources', '2026-04_Canada-Resource-Wealth_Essay'],
];
const frAnalyses = analysesOrder.map(([slug, file]) => {
  const d = yaml.load(readFileSync(resolve(process.cwd(), `content/articles/${file}.yaml`), 'utf-8')) as Record<string, any>;
  return {
    slug,
    title: d.title_fr ?? '',
    category: d.category_fr ?? '',
    readTime: d.readTime ?? '',
    subtitle: (d.subtitle_fr && d.subtitle_fr !== d.subtitle_en) ? d.subtitle_fr : '',
  };
});

// Reading-view fallback data (both languages) for OLD browsers that can't run
// the React app (e.g. Safari 15.x on an iPad mini 4). EN/FR titles, categories,
// and subtitles come from the article YAMLs (Peggy's reviewed French) so the
// list never drifts. `hasStatic` marks articles that have a server-rendered
// .astro page (readable on old Safari); the two without one are shown as plain
// text, not dead links to a blank page.
const STATIC_PORTFOLIO_SLUGS = new Set([
  'resource-civilization', 'canada-multipolar', 'critical-minerals', 'ai-governance', 'canada-forest-carbon',
]);
const fallbackArticles = analysesOrder.map(([slug, file]) => {
  const d = yaml.load(readFileSync(resolve(process.cwd(), `content/articles/${file}.yaml`), 'utf-8')) as Record<string, any>;
  return {
    slug,
    hasStatic: STATIC_PORTFOLIO_SLUGS.has(slug),
    titleEn: d.title_en ?? '',
    titleFr: d.title_fr ?? d.title_en ?? '',
    categoryEn: d.category_en ?? '',
    categoryFr: d.category_fr ?? d.category_en ?? '',
    readTime: d.readTime ?? '',
    subtitleEn: d.subtitle_en ?? '',
    subtitleFr: (d.subtitle_fr && d.subtitle_fr !== d.subtitle_en) ? d.subtitle_fr : '',
  };
});
---
<Base title="Analyses — Geopolitics, Resources & Technology | TransHorizons">
  <div style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;" aria-hidden="true">
    <h1>Analyses: Geopolitics, Resources & Technology</h1>
    <p>Analyses and visual essays exploring the forces that shape our world — from resource geopolitics to digital governance and the strategic place of Canada within a shifting global order.</p>
    <nav>
      <a href="/">Home</a>
      <a href="/analyses">All Analyses</a>
      <a href="/notes">Notes &amp; Reflections</a>
      <a href="/about">About</a>
    </nav>
    <section>
      <h2>All Analyses</h2>
      <ul>
        <li>
          <a href="/portfolio/resource-civilization">Canada as a Resource Civilization</a>
          <span>Systems · 14 min</span>
          <p>Examines how resource structures shape Canada's development and position within evolving global systems. Tags: civilization, Canada, resources, energy transition, supply chains, geopolitics, critical minerals.</p>
        </li>
        <li>
          <a href="/portfolio/canada-multipolar">Canada in the Multipolar World</a>
          <span>Geopolitics · 12 min</span>
          <p>Analyzes how shifting power structures redefine Canada's position within a fragmented global order. Tags: Canada, multipolar, foreign policy, alliances, US-Canada, trade, sovereignty.</p>
        </li>
        <li>
          <a href="/portfolio/critical-minerals">Critical Minerals &amp; the Energy Transition</a>
          <span>Resources · 10 min</span>
          <p>Examines how material supply chains are reshaping industrial systems and geopolitical positioning. Tags: critical minerals, mining, Canada, supply chains, energy, battery metals, lithium, cobalt, nickel.</p>
        </li>
        <li>
          <a href="/portfolio/ai-governance">AI Governance &amp; Digital Sovereignty</a>
          <span>Technology · 13 min</span>
          <p>Explores how digital systems and governance models are restructuring technological and geopolitical power. Tags: AI, governance, digital policy, regulation, algorithms, global standards, technology policy.</p>
        </li>
        <li>
          <a href="/portfolio/canada-forest-system-climate-industrial-pressure">Canada's Forest System Under Climate and Industrial Pressure</a>
          <span>Systems · 16 min</span>
          <p>Examines how climate-driven disturbances, industrial structure, and geopolitical integration are reshaping Canada's forest system and its role within global resource and trade networks. Tags: forestry, Canada, climate change, wildfire, carbon, trade, industrial policy, environment.</p>
        </li>
        <li>
          <a href="/portfolio/canada-forest-carbon">Net Carbon Effect of Canadian Forest Ecosystems</a>
          <span>Resources · 18 min</span>
          <p>How unprecedented wildfires have reversed the role of Canada's boreal forests in the global carbon cycle — from net sink to 1,138 Mt CO₂e net source in 2023. Tags: carbon markets, forestry, Canada, climate policy, net zero, offsets, environment.</p>
        </li>
        <li>
          <a href="/portfolio/canada-resources">Canada's Resource Wealth in a Fractured World</a>
          <span>Resources · 16 min</span>
          <p>Canada's vast mineral endowment — lithium, cobalt, nickel, uranium, rare earths — has moved from a background economic asset to a front-line geopolitical variable. Tags: critical minerals, Canada, lithium, cobalt, uranium, rare earths, supply chains, US-Canada, Indigenous partnerships.</p>
        </li>
      </ul>
    </section>
  </div>

  <!-- Crawlable French SEO mirror — French titles/subtitles from the article YAMLs. -->
  <div lang="fr" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;" aria-hidden="true">
    <h1>Toutes les analyses</h1>
    <p>L'ensemble des essais analytiques, notes stratégiques et essais visuels — de la géopolitique des ressources à la gouvernance numérique et aux changements environnementaux.</p>
    <nav>
      <a href="/">Accueil</a>
      <a href="/analyses">Analyses</a>
      <a href="/notes">Notes et réflexions</a>
      <a href="/about">À propos</a>
    </nav>
    <section>
      <ul>
        {frAnalyses.map((a) => (
          <li>
            <a href={`/portfolio/${a.slug}?lang=fr`}>{a.title}</a>
            <span>{a.category} · {a.readTime}</span>
            {a.subtitle && <p>{a.subtitle}</p>}
          </li>
        ))}
      </ul>
    </section>
  </div>

  <!-- ── Old-browser reading fallback ─────────────────────────────────────────
       Hidden by default; revealed by the inline script below ONLY if the React
       app fails to boot (e.g. Safari 15.x on an iPad mini 4). Modern devices
       hydrate in a few hundred ms, the app is detected, and this stays hidden —
       so their experience is unchanged. Plain, old-Safari-safe CSS only (no
       Tailwind v4 / oklch / color-mix). Both languages; French reuses the
       article-YAML fields + existing FR copy (only new FR is FR-PLACEHOLDER). -->
  <div id="th-legacy" class="th-fallback" style="display:none;">
    <div class="thf-wrap">
      <p class="thf-kicker">TransHorizons — Reading view</p>
      <p class="thf-lang"><a href="#thf-en">English</a> · <a href="#thf-fr">Français</a></p>

      <section id="thf-en" lang="en">
        <h1>All Analyses</h1>
        <p class="thf-intro">The full collection of analytical essays, briefs, and visual essays — from resource geopolitics to digital governance and environmental change.</p>
        <ul class="thf-list">
          {fallbackArticles.map((a) => (
            <li>
              {a.hasStatic
                ? <a href={`/portfolio/${a.slug}`}>{a.titleEn}</a>
                : <span class="thf-title-plain">{a.titleEn}</span>}
              <div class="thf-meta">{[a.categoryEn, a.readTime, a.hasStatic ? '' : 'full site only'].filter(Boolean).join(' · ')}</div>
              {a.subtitleEn && <p class="thf-desc">{a.subtitleEn}</p>}
            </li>
          ))}
        </ul>
      </section>

      <section id="thf-fr" lang="fr">
        <h1>Toutes les analyses</h1>
        <p class="thf-intro">L'ensemble des essais analytiques, notes stratégiques et essais visuels — de la géopolitique des ressources à la gouvernance numérique et aux changements environnementaux.</p>
        <ul class="thf-list">
          {fallbackArticles.map((a) => (
            <li>
              {a.hasStatic
                ? <a href={`/portfolio/${a.slug}?lang=fr`}>{a.titleFr}</a>
                : <span class="thf-title-plain">{a.titleFr}</span>}
              {/* FR-PLACEHOLDER: "site complet uniquement" note — Peggy to verify wording. */}
              <div class="thf-meta">{[a.categoryFr, a.readTime, a.hasStatic ? '' : 'site complet uniquement'].filter(Boolean).join(' · ')}</div>
              {a.subtitleFr && <p class="thf-desc">{a.subtitleFr}</p>}
            </li>
          ))}
        </ul>
      </section>

      <p class="thf-foot"><a href="/">← Home · Accueil</a></p>
    </div>
  </div>

  <AppShell client:only="react" />

  <script is:inline>
    /* Reveal the reading fallback ONLY when the React island fails to boot (old
       Safari, e.g. iPad mini 4). Modern browsers hydrate within a few hundred
       ms, the app is detected, and the fallback stays hidden — their experience
       is untouched. ES5-only so it parses on Safari 15.x. Must be is:inline so
       Astro does not hoist it into a module (which old Safari would also drop). */
    (function () {
      var legacy = document.getElementById('th-legacy');
      if (!legacy) return;
      function island() { return document.querySelector('astro-island'); }
      function rendered() { var i = island(); return !!(i && i.children.length > 0); }
      function showApp() { legacy.style.display = 'none'; var i = island(); if (i) i.style.display = ''; }
      function showLegacy() { legacy.style.display = 'block'; var i = island(); if (i) i.style.display = 'none'; }
      var hadError = false;
      window.addEventListener('error', function () { hadError = true; }, true);
      var elapsed = 0;
      var timer = setInterval(function () {
        elapsed += 300;
        if (rendered()) { showApp(); clearInterval(timer); return; }   // app booted → keep fallback hidden
        // App not up yet. Reveal on a real boot error fast, else after a safe timeout.
        if ((hadError && elapsed >= 600) || elapsed >= 6000) {
          showLegacy();
          if (elapsed >= 12000) clearInterval(timer);   // stop; a slow modern app self-corrects via rendered() above
        }
      }, 300);
    })();
  </script>

  <style>
    .thf-wrap {
      max-width: 720px;
      margin: 0 auto;
      padding: 28px 20px 72px;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      color: #1a1a1a;
      background: #ffffff;
      line-height: 1.55;
    }
    .thf-kicker { font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: #7d1a2e; margin: 0 0 6px; }
    .thf-lang { font-size: 14px; margin: 0 0 8px; }
    .thf-lang a, .thf-list a, .thf-foot a { color: #7d1a2e; }
    .thf-wrap h1 { font-size: 27px; font-weight: 600; margin: 34px 0 6px; }
    .thf-intro { color: #555555; margin: 0 0 18px; }
    .thf-list { list-style: none; margin: 0; padding: 0; }
    .thf-list li { padding: 16px 0; border-top: 1px solid #e4e4e4; }
    .thf-list a, .thf-title-plain { font-size: 19px; font-weight: 600; text-decoration: none; display: inline-block; }
    .thf-title-plain { color: #9a9a9a; }
    .thf-meta { font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: #a0a0a0; margin: 5px 0; }
    .thf-desc { color: #444444; margin: 6px 0 0; font-size: 15px; }
    .thf-foot { margin-top: 44px; font-size: 15px; }
  </style>
</Base>
