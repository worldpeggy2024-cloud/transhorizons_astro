---
// src/pages/portfolio/canada-multipolar.astro
// The React app (AppShell) is the SINGLE visual renderer for every entry path
// (F5/direct AND in-app navigation), so the layout can no longer drift between
// the two. Crawlable SEO text + the old-browser reading view are rendered by
// ArticleSeoFallback from the SAME YAML the React page reads.
import Base from '../../layouts/Base.astro';
import AppShell from '../../components/AppShell';
import ArticleSeoFallback from '../../components/ArticleSeoFallback.astro';
import { readFileSync } from 'fs';
import { resolve } from 'path';
import yaml from 'js-yaml';
export const prerender = false;

const data = yaml.load(
  readFileSync(resolve(process.cwd(), 'content/articles/2026-03_Canada-Multipolar_Essay.yaml'), 'utf-8')
) as Record<string, any>;
const L = (Astro.url.searchParams.get('lang') === 'fr') ? 'fr' : 'en';

const title = data[`title_${L}`] ?? '';
const subtitle = data[`subtitle_${L}`] ?? '';
const sections = (data.sections ?? [])
  .map((s: Record<string, any>) => ({ title: s[`title_${L}`] ?? '', content: s[`content_${L}`] ?? '' }))
  .filter((s: { title: string }) => !s.title.trim().toLowerCase().startsWith('sources'));
const keyTakeaways = (data.keyTakeaways ?? [])
  .map((k: Record<string, string>) => ({ description: k[`description_${L}`] ?? '' }))
  .filter((k: { description: string }) => k.description);
const sources: string[] = data.sources?.[L] ?? data.sources?.en ?? [];
---
<Base title={`${title} — TransHorizons`} description={subtitle}>
  <ArticleSeoFallback
    lang={L}
    reviewSlug="canada-multipolar"
    title={title}
    subtitle={subtitle}
    introTitle={data[`introductionTitle_${L}`] ?? ''}
    intro={data[`introduction_${L}`] ?? ''}
    category={data[`category_${L}`] ?? ''}
    date={data.date ?? ''}
    readTime={data.readTime ?? ''}
    sections={sections}
    keyTakeaways={keyTakeaways}
    sources={sources}
    backHref="/analyses"
    backLabel={L === 'fr' ? 'Retour au portfolio' : 'Back to Portfolio'}
  />
  <AppShell client:only="react" />
</Base>
