---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'TransHorizons',
  description = 'Structured analysis of geopolitical, resource, and technological systems, particularly those shaping Canada\'s position in the world. Independent research by Peggy Brenier, Montreal.'
} = Astro.props;

// Canonical origin is the astro.config `site` (Astro.site) — single source of
// truth, currently https://transhorizons.net (the public face), NOT the fly.dev
// working host. Both serve the same app, so a canonical consolidates search
// signals onto .net. Self-referential per path; ?lang=fr is preserved only for
// pages that have a distinct French SSR version (portfolio/notes), matching the
// sitemap's hreflang model.
let canonicalPath = Astro.url.pathname;
if (canonicalPath.length > 1 && canonicalPath.endsWith('/')) {
  canonicalPath = canonicalPath.slice(0, -1);
}
const canonicalSuffix = Astro.url.searchParams.get('lang') === 'fr' ? '?lang=fr' : '';
const canonicalHref = new URL(canonicalPath + canonicalSuffix, Astro.site ?? 'https://transhorizons.net').href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalHref} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,300;0,400;0,500;1,400&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
