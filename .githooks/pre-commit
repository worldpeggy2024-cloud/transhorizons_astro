#!/bin/sh
#
# pre-commit — auto-normalize Canadian-French typography in staged country reports.
#
# Runs the two FR tools (--write) on any staged content/countries/<ISO3>/analysis.yaml,
# then re-stages the result so the corrected spacing is what actually gets committed:
#   • scripts/fix-fr-semicolon-spaces.cjs  (removes the France-French space before ;)
#   • scripts/fix-fr-typography.cjs        (narrow NBSP before : « » — , numbers, %, units)
#
# Non-blocking: if a file would fail validation the tool skips it (and prints why) and
# the commit still proceeds. Enable with:  git config core.hooksPath .githooks
# (done automatically by the `prepare` npm script on `npm install`).
#
# NOTE: the tools rewrite the working-tree copy of each staged file, so UNSTAGED edits
# to the same country file get pulled into the commit too. For whole-file edits (the
# usual Keystatic case) that's a no-op difference.

# Country reports AND articles. Articles were added 2026-08-15: their French is
# authored the same way and deserves the same treatment, and the alternative was
# remembering to run the tools by hand for one content type but not the other.
# fix-fr-typography.cjs detects the nesting difference itself (articles keep
# their French inside sections:/keyTakeaways:, country reports are flat).
files=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '^content/(countries/.+/analysis|articles/.+)\.ya?ml$')
[ -z "$files" ] && exit 0

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: 'node' not found — skipping FR typography normalization." >&2
  exit 0
fi

echo "pre-commit: normalizing Canadian-French typography in staged content…"
node scripts/fix-fr-semicolon-spaces.cjs $files --write
node scripts/fix-fr-typography.cjs $files --write

git add $files
exit 0
